# Copy this file to .env.local and fill in real values before deploying.

# Formspree form endpoint ID. Sign up at https://formspree.io, create a form,
# and paste the ID from the endpoint URL: https://formspree.io/f/XXXXXXX
NEXT_PUBLIC_FORMSPREE_ID=your_formspree_id_here

# Site URL used for metadata, sitemap.xml and robots.txt. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://techvech.com

# Optional: Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave blank to disable.
NEXT_PUBLIC_GA_ID=

# Optional: token from Google Search Console -> "HTML tag" verification method.
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# Set to "true" only on a preview deployment to see placeholder case studies.
NEXT_PUBLIC_SHOW_PLACEHOLDERS=false
